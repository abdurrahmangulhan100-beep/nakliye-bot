# Bot ortam değişkenleri (host panelinden girin; bu dosyayı gerçek değerlerle repoya YÜKLEMEYİN)
TELEGRAM_BOT_TOKEN=
TELEGRAM_KANAL_ID=-100xxxxxxxxxx
SUPABASE_URL=https://xxxx.supabase.co
# service_role anahtarı: Supabase > Project Settings > API. Yalnızca bu sunucuda durur, siteye/Cloudflare'e ASLA girilmez.
SUPABASE_SERVICE_ROLE_KEY=
PHONE_NUMBER=905xxxxxxxxx
PANEL_KEY=uzun-rastgele-bir-sifre
# Host'ta kalıcı disk varsa oturum dosyası oraya (aksi halde her yeniden başlatmada WhatsApp eşleştirmesi sıfırlanır)
AUTH_DIR=/data/auth_info

# --- İsteğe bağlı ---
# Yurt dışı (Irak, Almanya, Erbil, KKTC...) ilanları atılsın mı
YABANCI_ILANLARI_ENGELLE=true
# Mesajda firma adı yoksa gönderenin WhatsApp profil adı firma olarak yazılsın mı
GONDERICI_ADINI_FIRMA_KULLAN=true
# Hiçbir ad bulunamazsa yazılacak firma
VARSAYILAN_FIRMA=WhatsApp Lojistik Akışı
